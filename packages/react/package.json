{
  "name": "@densedash/react",
  "version": "0.0.0",
  "description": "densedash React adapter (scaffold).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnthonyAltieri/densedash.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "publint": "publint --strict",
    "attw": "attw --pack --profile esm-only"
  }
}

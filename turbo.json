{
  "$schema": "https://turborepo.com/schema.json",
  "cacheDir": ".turbo/cache",
  "globalEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
  "globalDependencies": ["tooling/tsdown-config/**", "tooling/tsconfig/**", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "//#lint": {
      "cache": false
    },
    "//#typecheck": {
      "cache": false,
      "dependsOn": [
        "@densedash/core#build",
        "@densedash/css#build",
        "@densedash/react#build",
        "@densedash/plugin-tanstack-virtual#build"
      ]
    },
    "//#test": {
      "cache": false,
      "dependsOn": [
        "@densedash/core#build",
        "@densedash/css#build",
        "@densedash/react#build",
        "@densedash/plugin-tanstack-virtual#build"
      ]
    }
  }
}
